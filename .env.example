# ==============================================================================
# FINORA Environment Configuration
# Copy this file to .env.local for local development.
# Configure the same server variables in Vercel Project Settings -> Environment Variables.
# NEVER commit real secrets to Git.
# ==============================================================================

# --- Public Client Variables (Safe to expose to browser) ---
VITE_APP_NAME=FINORA
VITE_TELEGRAM_BOT_USERNAME=your_finora_bot

# --- Server-Only Supabase Configuration (NEVER prefix with VITE_) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Server-Only Telegram Bot Configuration (NEVER expose to browser) ---
TELEGRAM_BOT_TOKEN=123456789:your-botfather-token-here

# --- Server-Only Session & Security Configuration ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-bytes-of-cryptographically-random-hex
# Session lifetime in seconds (default: 604800 = 7 days)
SESSION_TTL_SECONDS=604800
# Maximum accepted Telegram initData auth_date age in seconds (default: 300 = 5 minutes)
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
# Public origin of the deployed Mini App (used for strict CORS checks)
APP_URL=https://your-finora-app.vercel.app

# --- Optional Free Exchange Rate Provider (No API key required) ---
# Defaults to https://open.er-api.com/v6/latest/USD (zero-cost open endpoint)
EXCHANGE_RATE_PROVIDER_URL=https://open.er-api.com/v6/latest/USD

# --- Optional Cron Protection (Vercel Cron secret for later phases) ---
CRON_SECRET=replace-with-random-secret-for-vercel-cron
